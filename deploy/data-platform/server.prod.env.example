# Copy to /etc/data-platform/prod/server.env; keep production database names when adopting.
DATA_PLATFORM_ENV=prod
DATA_PLATFORM_INSTANCE_ID=REPLACE_WITH_UUID
DATA_PLATFORM_STATE_ROOT=/srv/data-platform
DATA_PLATFORM_ENABLE_DEV_ROLE_SWITCH=0
DATA_PLATFORM_DEPLOY_AGENT_HOST=REPLACE_WITH_SSH_HOST
DATA_PLATFORM_DEPLOY_IDENTITY_FILE=/home/DEPLOY_USER/.ssh/KEY_FILE
DATA_PLATFORM_DEPLOY_AGENT_NAMES=REPLACE_WITH_NODE_NAME
# Replace placeholders in /etc/data-platform/prod/server.env; environment init sets ownership and mode 640.
DATA_PLATFORM_ROOT=/srv/data-platform/datasets
DATA_PLATFORM_OUTPUT_DIR=/srv/data-platform/console
DATA_PLATFORM_REMOTE_CACHE_ROOT=/srv/data-platform/remote-cache
DATA_PLATFORM_DATABASE_URL=mysql+pymysql://data_platform_prod:URL_ENCODED_PASSWORD@mysql.internal:3306/data_platform_prod?charset=utf8mb4
DATA_PLATFORM_BOOTSTRAP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE
DATA_PLATFORM_AGENT_ENROLLMENT_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
DATA_PLATFORM_ALLOW_REGISTRATION=0
DATA_PLATFORM_CONSOLE_MODE=full
DATA_PLATFORM_ENABLE_LEGACY_MUTATIONS=0
DATA_PLATFORM_TRUST_PROXY=1
DATA_PLATFORM_PROTECTED_SOURCE_ROOTS=/srv/data-platform/raw

# Shared Qwen credential: task suggestions, Qwen API object labeling and VLM auto-tagging.
# Set the real key only in /etc/data-platform/prod/server.env, never in the repository.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Task suggestions may use a different model from image-based labeling/tagging.
DATA_PLATFORM_TASK_MODEL=qwen3.6-plus

# Separate logical log database; use a dedicated account. Required for audit querying/delivery.
DATA_PLATFORM_LOG_DATABASE_URL=mysql+pymysql://data_platform_logs_prod:URL_ENCODED_PASSWORD@mysql.internal:3306/data_platform_logs_prod?charset=utf8mb4
DATA_PLATFORM_LOCAL_SERVER_URL=http://127.0.0.1:9091
DATA_PLATFORM_USER_RUNNING_LIMIT=1
DATA_PLATFORM_NODE_RUNNING_LIMIT=1
DATA_PLATFORM_USER_QUEUE_LIMIT=20
DATA_PLATFORM_OUTBOX_MAX_EVENTS=100000
DATA_PLATFORM_AUDIT_SPOOL_BYTES=268435456
DATA_PLATFORM_COMPUTE_CPU_FRACTION=0.5
DATA_PLATFORM_COMPUTE_MEMORY_FRACTION=0.6
# Set to 1 during a coordinated Server A / Agent upgrade.
DATA_PLATFORM_PAUSE_CLAIMS=0
# GPU work is disabled until explicit device IDs are assigned.
DATA_PLATFORM_GPU_DEVICES=
