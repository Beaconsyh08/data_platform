# Copy to /etc/data-platform/agent.env, replace every placeholder, and chmod 600.
DATA_PLATFORM_SERVER_URL=https://data-platform.example.com
DATA_PLATFORM_AGENT_NAME=server-b
DATA_PLATFORM_AGENT_ALLOWED_ROOTS=/data/datasets
DATA_PLATFORM_AGENT_WRITABLE_ROOTS=/data
DATA_PLATFORM_AGENT_ALLOW_SOURCE_MUTATIONS=0
DATA_PLATFORM_AGENT_STATE=/var/lib/data-platform-agent/agent.json
DATA_PLATFORM_AGENT_ENROLLMENT_TOKEN=REPLACE_WITH_THE_SERVER_ENROLLMENT_TOKEN

# Optional per-job budgets. Unset keeps the legacy four-worker/fraction defaults.
# Absolute limits override fractions and are capped by inherited CPU/memory limits.
# DATA_PLATFORM_COMPUTE_MAX_WORKERS=32
# DATA_PLATFORM_COMPUTE_CPU_LIMIT=32
# DATA_PLATFORM_COMPUTE_MEMORY_LIMIT_GIB=64
# DATA_PLATFORM_COMPUTE_NATIVE_THREADS=1
# DATA_PLATFORM_VIDEO_THREADS=2
